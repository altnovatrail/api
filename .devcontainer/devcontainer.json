// Devcontainer for NovaTrail's api: all development happens here.
// Tool versions are pinned directly in this file and in .devcontainer/Dockerfile.
{
    "name": "novatrail-api",
    "build": {
        "dockerfile": "Dockerfile",
        // The full environment, not the toolchain stage on its own.
        "target": "devcontainer",
        // The image copies nothing from the repository but what its kind puts in this folder,
        // gopls/, so it is built from this folder alone.
        "context": "."
    },
    "remoteUser": "vscode",
    // Closing the window leaves the container running, and docker stop ends it: the orchestrator's
    // executor runs in it by docker exec, with no window (R156 spec).
    "shutdownAction": "none",
    // Runs on the host before the container starts, in this folder: gives it a network whose MTU
    // is the host's own, so a tunnel on the host does not silently truncate large downloads here,
    // and makes the folder of the epics beside the clones, which the mount below needs: Docker
    // refuses a bind whose source is missing.
    "initializeCommand": "bash .devcontainer/host-network.sh && mkdir -p ../.epics",
    "runArgs": [
        "--network=novatrail-api",
        // The container's name in its network, the repository's: a container that joins the
        // network too — app's, on api's — reaches it by that name, as http://api:8080, whatever
        // address a rebuild gives it. Docker gives it the first --network alone, so the
        // repository's own network stays first; and one container of a repository runs at a
        // time, since a second would take the same name.
        "--network-alias=api"
    ],
    "mounts": [
        // The sign-ins live in volumes shared by the containers of every NovaTrail repository:
        // they survive rebuilds, and one sign-in serves them all.
        // Claude Code login and settings. It keeps a memory directory per git repository,
        // under projects/ here, so one volume does not mix the repositories' memories.
        "source=novatrail-claude,target=/home/vscode/.claude,type=volume",
        // Codex's ChatGPT sign-in, settings and chat history: its default home, kept the same way.
        "source=novatrail-codex,target=/home/vscode/.codex,type=volume",
        // And the GitHub one, so that `gh auth login` is answered once rather than once
        // per rebuild.
        "source=novatrail-gh,target=/home/vscode/.config/gh,type=volume",
        // The VS Code extensions, in a volume of this container's own: ${devcontainerId} stays
        // the same across rebuilds and differs between repositories. Without it a rebuild
        // downloads every extension again, and an install cut short by a reload is never
        // finished: extensions are installed only when the container is created. With it the
        // next rebuild finds them in place and installs only what is missing.
        "source=novatrail-vscode-extensions-${devcontainerId},target=/home/vscode/.vscode-server/extensions,type=volume",
        // The clones of the tasks across repositories, .epics/<epic>/<repo> beside the host's clones:
        // every NovaTrail container mounts this one folder of the host, at one path, and nothing
        // else beside the clones (R166 spec).
        "source=${localWorkspaceFolder}/../.epics,target=/workspaces/.epics,type=bind",
        // api's own: the configuration of the dev projects — a service account's key and the
        // connection strings — outside the repository and any git working tree, kept across
        // rebuilds; just dev reads it. The author puts the files in it.
        "source=novatrail-api-dev,target=/home/vscode/.novatrail-dev,type=volume",
        // api's own too, shared with app's container, which mounts it read-only: the custom token
        // of the test account dev-app, which `just dev-app` lays anew while it runs, and nothing
        // else — no key, no configuration.
        "source=novatrail-dev-token,target=/home/vscode/.novatrail-token,type=volume"
    ],
    "containerEnv": {
        // Tells an agent's session, Claude's or Codex's, that it runs in here, the one place
        // it may work.
        "NOVATRAIL_DEVCONTAINER": "1",
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "DISABLE_AUTOUPDATER": "1",
        // Claude Code loads the plugins of spec's claude-plugins/ that this repository's kind names in
        // every session here, from this container's own path: a marketplace would be recorded in the
        // ~/.claude that the containers share, by the path of one of them, and the sessions of the
        // others would lose it (R143 spec).
        "CLAUDE_CODE_PLUGIN_DIRS": "${containerWorkspaceFolder}/spec/claude-plugins/gopls-lsp"
    },
    // spec is a submodule: a clone made without --recurse-submodules gets it here.
    "postStartCommand": "test -e spec/RULES.md || git submodule update --init spec",
    "customizations": {
        "vscode": {
            "settings": {
                "files.eol": "\n",
                "files.insertFinalNewline": true,
                // Every commit made from Source Control carries Signed-off-by, as the DCO asks
                // of every contribution. From a terminal it is `git commit -s`.
                "git.alwaysSignOff": true,
                // spec is a read-only submodule of every other NovaTrail repository: Source
                // Control does not offer it as one more repository to commit in.
                "git.detectSubmodules": false,
                // The settings of this repository's kind.
                "go.toolsManagement.autoUpdate": false,
                "go.toolsManagement.checkForUpdates": "off",
                "go.lintOnSave": "off"
            },
            // Exact versions; the Claude Code extension matches CLAUDE_CODE_VERSION.
            "extensions": [
                "anthropic.claude-code@2.1.280",
                // OpenAI's coding agent, signed in with a ChatGPT plan. The extension brings
                // its own CLI and sandbox, so the image installs nothing for it.
                "openai.chatgpt@26.1007.21434",
                "redhat.vscode-yaml@1.24.0",
                // Starts just-lsp, which the image installs at JUST_LSP_VERSION.
                "nefrob.vscode-just-syntax@0.10.2",
                // Mermaid in the Markdown preview: the prerequisite DAG and the data flows.
                "bierner.markdown-mermaid@1.32.1",
                "eamodio.gitlens@19.2.0",
                // The extensions of this repository's kind.
                "golang.go@0.56.1"
            ]
        }
    }
}
